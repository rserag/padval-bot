#!/usr/bin/python3
"""Root-owned, fail-closed Padval Bot release controller."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path, PurePosixPath
from typing import NoReturn


ROOT = Path("/opt/padval-status-bot")
RELEASES = ROOT / "releases"
STATE = ROOT / "state"
CURRENT_LINK = ROOT / "current"
UNIT_SOURCE_NAME = "deploy/padval-status-bot.service"
UNIT_PATH = Path("/etc/systemd/system/padval-status-bot.service")
BOOTSTRAP_UNIT = ROOT / "bootstrap/padval-status-bot.service"
PRIVATE_CONFIG = Path("/etc/padval-status-bot/config.json")
HEARTBEAT = Path("/var/lib/padval-status-bot/heartbeat")
MAX_ARCHIVE_BYTES = 8 * 1024 * 1024
REVISION = re.compile(r"[0-9a-f]{40}")
SYSTEMCTL = "/usr/bin/systemctl"


def fail(message: str) -> NoReturn:
    raise SystemExit(f"deployment failed: {message}")


def run(
    args: list[str], *, env: dict[str, str] | None = None, timeout: int = 120
) -> None:
    result = subprocess.run(
        args,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=timeout,
        check=False,
    )
    if result.returncode != 0:
        fail(f"validation command exited {result.returncode}")


def allowed_member(name: str) -> bool:
    exact = {"pyproject.toml", "README.md", "SECURITY.md", UNIT_SOURCE_NAME}
    if name in exact:
        return True
    return bool(
        re.fullmatch(r"src/padval_bot/[A-Za-z0-9_]+\.py", name)
        or re.fullmatch(r"tests/test_[A-Za-z0-9_]+\.py", name)
        or name == "config/torrent-locations.yaml"
    )


def receive_archive(destination: Path) -> Path:
    archive = destination / "release.tar.gz"
    size = 0
    with archive.open("wb") as handle:
        while True:
            chunk = sys.stdin.buffer.read(65536)
            if not chunk:
                break
            size += len(chunk)
            if size > MAX_ARCHIVE_BYTES:
                fail("release archive is too large")
            handle.write(chunk)
    if size == 0:
        fail("release archive is empty")
    return archive


def extract_archive(archive: Path, destination: Path) -> None:
    seen: set[str] = set()
    total = 0
    with tarfile.open(archive, "r:gz") as bundle:
        for member in bundle.getmembers():
            name = member.name.removeprefix("./")
            pure = PurePosixPath(name)
            if member.isdir():
                continue
            if (
                pure.is_absolute()
                or ".." in pure.parts
                or not member.isfile()
                or not allowed_member(name)
                or name in seen
            ):
                fail("release archive contains an unexpected member")
            seen.add(name)
            total += member.size
            if total > MAX_ARCHIVE_BYTES:
                fail("expanded release is too large")
            source = bundle.extractfile(member)
            if source is None:
                fail("release member could not be read")
            target = destination / name
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open("wb") as handle:
                shutil.copyfileobj(source, handle)
            target.chmod(0o644)
    required = {
        "pyproject.toml",
        "config/torrent-locations.yaml",
        UNIT_SOURCE_NAME,
        "src/padval_bot/__init__.py",
        "src/padval_bot/__main__.py",
        "src/padval_bot/main.py",
        "src/padval_bot/config.py",
        "src/padval_bot/telegram.py",
        "src/padval_bot/torrent.py",
    }
    if not required.issubset(seen):
        fail("release archive is incomplete")


def release_environment(release: Path) -> dict[str, str]:
    environment = os.environ.copy()
    environment["PYTHONPATH"] = str(release / "src")
    return environment


def validate_release(release: Path) -> None:
    environment = release_environment(release)
    run(["/usr/bin/python3", "-m", "compileall", "-q", str(release / "src")])
    run(
        [
            "/usr/bin/python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            str(release / "tests"),
            "-v",
        ],
        env=environment,
    )
    common = [
        "/usr/bin/python3",
        "-m",
        "padval_bot",
        "--config",
        str(PRIVATE_CONFIG),
        "--torrent-locations",
        str(release / "config/torrent-locations.yaml"),
    ]
    run([*common, "--check-config"], env=environment)
    run([*common, "--check-torrent-paths"], env=environment)


def atomic_symlink(target: Path, link: Path) -> None:
    temporary = link.with_name(f".{link.name}.tmp")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, link)


def write_state(name: str, value: str) -> None:
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = STATE / name
    temporary = path.with_name(f".{name}.tmp")
    temporary.write_text(value + "\n", encoding="ascii")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def restart_and_wait(started_at: float) -> bool:
    subprocess.run([SYSTEMCTL, "daemon-reload"], check=False)
    restarted = subprocess.run(
        [SYSTEMCTL, "restart", "padval-status-bot.service"], check=False
    )
    if restarted.returncode != 0:
        return False
    deadline = time.monotonic() + 75
    while time.monotonic() < deadline:
        active = (
            subprocess.run(
                [SYSTEMCTL, "is-active", "--quiet", "padval-status-bot.service"],
                check=False,
            ).returncode
            == 0
        )
        try:
            fresh = HEARTBEAT.stat().st_mtime >= started_at
        except OSError:
            fresh = False
        if active and fresh:
            time.sleep(5)
            return (
                subprocess.run(
                    [SYSTEMCTL, "is-active", "--quiet", "padval-status-bot.service"],
                    check=False,
                ).returncode
                == 0
            )
        time.sleep(2)
    return False


def restart_active_only() -> bool:
    subprocess.run([SYSTEMCTL, "daemon-reload"], check=False)
    if (
        subprocess.run(
            [SYSTEMCTL, "restart", "padval-status-bot.service"], check=False
        ).returncode
        != 0
    ):
        return False
    time.sleep(5)
    return (
        subprocess.run(
            [SYSTEMCTL, "is-active", "--quiet", "padval-status-bot.service"],
            check=False,
        ).returncode
        == 0
    )


def restore(previous: Path | None, started_at: float) -> None:
    if previous is not None:
        atomic_symlink(previous, CURRENT_LINK)
        shutil.copy2(previous / UNIT_SOURCE_NAME, UNIT_PATH)
        healthy = restart_and_wait(started_at)
    else:
        CURRENT_LINK.unlink(missing_ok=True)
        if not BOOTSTRAP_UNIT.is_file():
            fail("bootstrap unit is unavailable for rollback")
        shutil.copy2(BOOTSTRAP_UNIT, UNIT_PATH)
        healthy = restart_active_only()
    if not healthy:
        fail("automatic rollback did not become healthy")


def deploy(revision: str) -> None:
    if not REVISION.fullmatch(revision):
        fail("invalid revision")
    if not PRIVATE_CONFIG.is_file():
        fail("private runtime configuration is missing")
    ROOT.mkdir(mode=0o755, parents=True, exist_ok=True)
    ROOT.chmod(0o755)
    RELEASES.mkdir(mode=0o755, parents=True, exist_ok=True)
    RELEASES.chmod(0o755)
    with tempfile.TemporaryDirectory(prefix="incoming-", dir=ROOT) as incoming_name:
        incoming = Path(incoming_name)
        archive = receive_archive(incoming)
        candidate = incoming / "candidate"
        candidate.mkdir()
        extract_archive(archive, candidate)
        validate_release(candidate)
        release = RELEASES / revision
        if release.exists():
            shutil.rmtree(candidate)
        else:
            os.replace(candidate, release)
        for path in release.rglob("*"):
            if path.is_file():
                path.chmod(0o644)
        release.chmod(0o755)

    previous = CURRENT_LINK.resolve() if CURRENT_LINK.is_symlink() else None
    previous_revision = previous.name if previous is not None else "bootstrap"
    unit_source = release / UNIT_SOURCE_NAME
    shutil.copy2(unit_source, UNIT_PATH)
    UNIT_PATH.chmod(0o644)
    atomic_symlink(release, CURRENT_LINK)
    started_at = time.time()
    if not restart_and_wait(started_at):
        restore(previous, time.time())
        fail("candidate was unhealthy; previous release restored")
    write_state("previous", previous_revision)
    write_state("current", revision)

    releases = sorted(
        (
            path
            for path in RELEASES.iterdir()
            if path.is_dir() and REVISION.fullmatch(path.name)
        ),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    protected = {revision, previous.name if previous is not None else ""}
    for old in releases[5:]:
        if old.name not in protected:
            shutil.rmtree(old)
    print(f"deployed revision={revision}")


def status() -> None:
    current = (
        (STATE / "current").read_text(encoding="ascii").strip()
        if (STATE / "current").is_file()
        else "bootstrap"
    )
    active = (
        subprocess.run(
            [SYSTEMCTL, "is-active", "--quiet", "padval-status-bot.service"],
            check=False,
        ).returncode
        == 0
    )
    print(f"revision={current} active={'yes' if active else 'no'}")


def main() -> None:
    if os.geteuid() != 0:
        fail("controller must run as root")
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        status()
        return
    if len(sys.argv) == 3 and sys.argv[1] == "deploy":
        deploy(sys.argv[2])
        return
    fail("unsupported command")


if __name__ == "__main__":
    main()
